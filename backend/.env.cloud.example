# Copy to backend/.env.cloud, fill in the secrets, then run:
#   go run ./cmd/preflight -env .env.cloud
# .env.cloud is git-ignored. Never commit real keys.

# --- Upstash Redis (use the Redis/TCP details, not the REST ones) ---
REDIS_ADDR=sharing-goose-245018.upstash.io:6379
REDIS_PASSWORD=<password from the Upstash console's Redis/TCP section>
REDIS_TLS=true

# --- Backblaze B2 (S3-compatible API) ---
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_PUBLIC_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=Ephemeral-Share
S3_ACCESS_KEY=<keyID of a key limited to this bucket>
S3_SECRET_KEY=<applicationKey shown once when you create it>

# Browsers are allowed to upload only from this origin (no trailing slash).
ALLOWED_ORIGIN=https://ephemeral-share-gray.vercel.app

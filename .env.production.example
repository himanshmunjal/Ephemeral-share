# Production template — fill in every placeholder. DEPLOY.md has the exact
# step-by-step; PRODUCTION.md explains the rationale. With GIN_MODE=release
# the backend self-checks these at boot and refuses to start on dev defaults.

GIN_MODE=release
# PORT is injected by Railway/Render — don't set it there.

# --- Redis (required). Must allow notify-keyspace-events; the backend tries
# to enable it itself at boot. ---
REDIS_ADDR=your-redis-host:6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
# true for managed Redis that only accepts TLS (Upstash, most cloud Redis).
# Leave unset for Railway's private network or a local/sidecar Redis.
# REDIS_TLS=true
# Set only if your Redis forbids CONFIG SET (see DEPLOY.md):
# ALLOW_NO_KEYSPACE_EVENTS=true

# --- Postgres (OPTIONAL): only for aggregate traffic stats. Leave unset to
# run Redis-only. ---
# POSTGRES_DSN=postgres://ephemeral_app:REPLACE@host:5432/ephemeral?sslmode=require

# --- Object storage: Cloudflare R2 (free tier) ---
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=ephemeral-share
S3_REGION=auto
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME

# Alternative storage with no card needed: Backblaze B2 (S3-compatible).
# S3_ENDPOINT=https://s3.<REGION>.backblazeb2.com
# S3_PUBLIC_ENDPOINT=https://s3.<REGION>.backblazeb2.com
# S3_REGION=<REGION, e.g. us-west-004 — shown on the bucket page>
# SIGN_CONTENT_LENGTH=false   # only if uploads fail with signature errors (see DEPLOY.md)

# Bind the declared upload size into the pre-signed URL (default true). Turn off
# only for S3-compatible stores that reject the signed header; the server still
# verifies the real size when an upload completes and deletes mismatches.
# SIGN_CONTENT_LENGTH=true

# --- Session + abuse limits (defaults shown) ---
SESSION_TTL_SECONDS=3600
MAX_UPLOAD_MB=25
MAX_FILES_PER_SESSION=20
MAX_SESSION_MB=100
MAX_TEXT_ITEMS_PER_SESSION=200
MAX_PARTICIPANTS=10
CODE_LENGTH=8
RATE_LIMIT_PER_MIN=60
UPLOAD_RATE_LIMIT_PER_MIN=30
MAX_FAILED_LOOKUPS=10
LOCKOUT_SECONDS=900
ORPHAN_SWEEP_SECONDS=600
ROOM_RATE_LIMIT_PER_MIN=240

# --- Network / security ---
# Exactly your Vercel URL(s), https only, comma-separated. For the mobile apps
# also add: capacitor://localhost,https://localhost
ALLOWED_ORIGIN=https://YOUR-APP.vercel.app
# Behind a platform proxy (Railway, Render, Cloud Run, Caddy...) the socket
# address is the proxy's, so per-IP rate limits and lockouts need the real client
# IP. "private" trusts loopback + private ranges and reads the real client from
# X-Forwarded-For (right-most untrusted address, so it can't be spoofed).
# VERIFY after deploy: the "ip" field in logs must show visitors' public IPs.
TRUSTED_PROXIES=private
# Alternative for a platform that overwrites a single-value header (e.g.
# Cloudflare: CF-Connecting-IP). Don't use this with X-Forwarded-For.
# CLIENT_IP_HEADER=
ENFORCE_HTTPS=true
# Optional takedown endpoint (DELETE /admin/sessions/:code, header X-Admin-Token).
# Generate with: openssl rand -hex 32
# ADMIN_TOKEN=

# --- Optional error tracking (Sentry free tier). Codes are scrubbed. ---
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# --- Frontend build-time vars (set in Vercel, not the backend) ---
# VITE_SENTRY_DSN=
# VITE_API_URL=https://YOUR-BACKEND.up.railway.app/api/v1
# VITE_CONTACT_EMAIL=abuse@yourdomain.com

# Production template — fill in every placeholder. See PRODUCTION.md for the
# full checklist and rationale behind each of these. Run the backend with
# GIN_MODE=release so it self-checks these at boot and refuses to start with
# leftover dev defaults.

GIN_MODE=release
PORT=8080

# Strong, generated password — not the docker-compose dev default.
POSTGRES_DSN=postgres://ephemeral_app:REPLACE_WITH_STRONG_PASSWORD@your-postgres-host:5432/ephemeral?sslmode=require

# Managed Redis MUST support notify-keyspace-events for expired keys (see
# PRODUCTION.md §1) — verify before choosing a provider/tier.
REDIS_ADDR=your-redis-host:6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# --- Object storage: pick ONE of the two blocks below ---

# AWS S3 (recommended): let the SDK resolve the endpoint and, ideally, run
# on an IAM role instead of static keys (omit S3_ACCESS_KEY/S3_SECRET_KEY).
S3_ENDPOINT=none
S3_PUBLIC_ENDPOINT=
S3_BUCKET=your-production-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Self-hosted MinIO / Cloudflare R2 (uncomment and fill in instead):
# S3_ENDPOINT=https://minio.internal.example.com
# S3_PUBLIC_ENDPOINT=https://cdn.example.com
# S3_BUCKET=your-production-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=REPLACE_ME
# S3_SECRET_KEY=REPLACE_ME

SESSION_TTL_SECONDS=300
MAX_UPLOAD_MB=200

# Real frontend domain(s), https:// only, comma-separated for multiple.
ALLOWED_ORIGIN=https://share.example.com

RATE_LIMIT_PER_MIN=60
CODE_LENGTH=6

# Frontend build-time var (frontend/.env) — https:// here makes the
# WebSocket connection automatically use wss:// (see PRODUCTION.md §4).
VITE_API_URL=https://api.example.com/api/v1

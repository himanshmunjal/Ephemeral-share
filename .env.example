# LOCAL DEV ONLY — see PRODUCTION.md for what must change before deploying
# (Redis keyspace notifications, credential rotation, CORS/TLS, S3 endpoint
# split). Do not copy these values into a production environment.

# Backend
PORT=8080
POSTGRES_DSN=postgres://postgres:postgres@postgres:5432/ephemeral?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
# Local (MinIO):
S3_ENDPOINT=http://minio:9000
# Must be reachable from the browser (used only to sign pre-signed upload/
# download URLs) — not the docker-compose service name.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=ephemeral-share
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Cloud (real AWS S3) — set S3_ENDPOINT=none to use the AWS SDK's default
# endpoint resolution instead of MinIO's. Omit S3_ACCESS_KEY/S3_SECRET_KEY
# entirely if the backend runs with an IAM role (ECS task role, EC2 instance
# profile, etc.) — the SDK's default credential chain will pick it up.
# S3_ENDPOINT=none
# S3_BUCKET=your-ephemeral-share-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
SESSION_TTL_SECONDS=300
MAX_UPLOAD_MB=200
ALLOWED_ORIGIN=http://localhost:5173
RATE_LIMIT_PER_MIN=60
CODE_LENGTH=8

# Frontend (frontend/.env)
VITE_API_URL=http://localhost:8080/api/v1
